# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/dorofeev_i_backend_unroll_BACKEND%shlibext -run-pass=dorofeev-loop-unroll %s -o - | FileCheck %s

--- |
  define void @test_unroll_loop() {
    ret void
  }
...
---
# CHECK: name: test_unroll_loop
name:            test_unroll_loop
tracksRegLiveness: true
body:             |
  bb.0:
    %0:gr32 = MOV32ri 0
    
  bb.1:
    ; Ожидаем 5 инструкций сложения (оригинал + 4 копии)
    
    ; CHECK: %{{[0-9]+}}:gr32 = ADD32ri
    ; CHECK: %{{[0-9]+}}:gr32 = ADD32ri
    ; CHECK: %{{[0-9]+}}:gr32 = ADD32ri
    ; CHECK: %{{[0-9]+}}:gr32 = ADD32ri
    ; CHECK: %{{[0-9]+}}:gr32 = ADD32ri
    
    %1:gr32 = ADD32ri %0, 1, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.2
    
  bb.2:
    RET64