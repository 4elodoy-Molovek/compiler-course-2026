# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/dorofeev_i_backend_unroll%shlibext -run-pass=dorofeev-loop-unroll %s -o - | FileCheck %s

--- |
  define void @test_unroll_loop() {
    ret void
  }
...
---
# CHECK: name: test_unroll_loop
name:            test_unroll_loop
tracksRegLiveness: true
body:             |
  bb.0:
    %0:gr32 = MOV32ri 0
    
  bb.1:
    ; Ожидаем, что инструкция ADD32ri размножится ровно 5 раз 
    ; (1 оригинальная + 4 копии) и каждый раз будет создаваться новый виртуальный регистр.
    
    ; CHECK: %1:gr32 = ADD32ri
    ; CHECK: %2:gr32 = ADD32ri
    ; CHECK: %3:gr32 = ADD32ri
    ; CHECK: %4:gr32 = ADD32ri
    ; CHECK: %5:gr32 = ADD32ri
    
    %1:gr32 = ADD32ri %0, 1
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.2
    
  bb.2:
    RET64
...